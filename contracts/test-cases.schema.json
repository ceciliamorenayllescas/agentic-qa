{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-cases.schema.json",
  "title": "Test Cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "test_cases",
    "not_designed_as_deterministic_cases"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "test_cases": {
      "type": "array",
      "items": {
        "$ref": "test-case.schema.json"
      }
    },
    "not_designed_as_deterministic_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "reason"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "test_design_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
