{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exploratory-finding.schema.json",
  "title": "Exploratory Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "status",
    "steps_to_reproduce",
    "expected",
    "actual"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "observation",
        "potential_defect",
        "confirmed_defect",
        "not_a_defect",
        "needs_investigation"
      ]
    },
    "steps_to_reproduce": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string",
      "minLength": 1
    },
    "feature": { "type": "string", "minLength": 1 },
    "charter": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["observation", "defect", "risk", "unknown_resolved", "unexpected_behavior"] },
    "expected_or_reference": { "type": "string", "minLength": 1 },
    "observed_behavior": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "unknown_id": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_ids", "risk_ids", "unknown_ids", "scope_items"],
      "properties": {
        "scenario_ids": { "type": "array", "items": { "type": "string" } },
        "risk_ids": { "type": "array", "items": { "type": "string" } },
        "unknown_ids": { "type": "array", "items": { "type": "string" } },
        "scope_items": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
