{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "report.schema.json",
"title": "QA Workflow Report",
"type": "object",
"additionalProperties": false,
"required": [
"schema_version",
"workflow_id",
"feature",
"generated_at",
"summary",
"artifacts"
],
"properties": {
"schema_version": {
"type": "string",
"const": "1.0"
},
"workflow_id": {
"type": "string",
"minLength": 1
},
"feature": {
"type": "string",
"minLength": 1
},
"generated_at": {
"type": "string",
"format": "date-time"
},
"summary": {
"type": "object",
"additionalProperties": false,
"required": [
"workflow_status",
"stages_completed",
"stages_total"
],
"properties": {
"workflow_status": {
"type": "string",
"enum": [
"completed",
"failed"
]
},
"stages_completed": {
"type": "integer",
"minimum": 0
},
"stages_total": {
"type": "integer",
"minimum": 0
}
}
},
"artifacts": {
"type": "object",
"additionalProperties": false,
"required": [
"discovery",
"test_design",
"exploratory",
"automation",
"execution",
"analysis"
],
"properties": {
"discovery": {
"type": "array",
"items": {
"type": "string"
}
},
"test_design": {
"type": "array",
"items": {
"type": "string"
}
},
"exploratory": {
"type": "array",
"items": {
"type": "string"
}
},
"automation": {
"type": "array",
"items": {
"type": "string"
}
},
"execution": {
"type": "array",
"items": {
"type": "string"
}
},
"analysis": {
"type": "array",
"items": {
"type": "string"
}
}
}
}
}
}
