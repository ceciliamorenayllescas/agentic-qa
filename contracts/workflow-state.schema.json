{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-state.schema.json",
  "title": "Agentic QA Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "feature", "status", "current_stage", "created_at", "updated_at", "stages"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "feature": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the feature definition, relative to the project root when possible."
    },
    "status": { "$ref": "#/$defs/status" },
    "resume_from_stage": { "anyOf": [{ "$ref": "#/$defs/stage_name" }, { "type": "null" }] },
    "current_stage": { "anyOf": [{ "$ref": "#/$defs/stage_name" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "test_design", "exploratory", "automation", "execution", "analysis", "report"],
      "properties": {
        "discovery": { "$ref": "#/$defs/stage" },
        "test_design": { "$ref": "#/$defs/stage" },
        "exploratory": { "$ref": "#/$defs/stage" },
        "automation": { "$ref": "#/$defs/stage" },
        "execution": { "$ref": "#/$defs/stage" },
        "analysis": { "$ref": "#/$defs/stage" },
        "report": { "$ref": "#/$defs/stage" }
      }
    }
  },
  "$defs": {
    "status": { "type": "string", "enum": ["pending", "running", "paused", "completed", "failed", "skipped"] },
    "stage_name": {
      "type": "string",
      "enum": ["discovery", "test_design", "exploratory", "automation", "execution", "analysis", "report"]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "completed_at", "artifacts", "error"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "started_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "completed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "error": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    }
  }
}
