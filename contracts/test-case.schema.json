{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-case.schema.json",
  "title": "Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "priority",
    "preconditions",
    "steps",
    "expected_results"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
        "type": "string",
        "enum": [
            "positive",
            "negative",
            "boundary",
            "validation",
            "permission",
            "error_handling",
            "regression",
            "exploratory"
        ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "test_data_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "expected_result"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "enum": ["select_option", "read_collection", "assert_collection_order"]
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "variable": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": ["string", "number"]
          },
          "collection": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "string",
            "enum": ["ascending", "descending"]
          }
        }
      }
    },
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
